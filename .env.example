# Copy this file to .env and fill in the values below.
# .env is gitignored — never commit real secrets.

# The GUS (Global Admin Account System) instance admins sign in against.
GUS_BASE_URL=https://auth.prismonian.com

# Credentials for THIS application, issued once by GUS:
#   npm run bootstrap -- --app proxystop
# (run from the GUS repo). GUS prints the secret exactly once — save it here.
GUS_APP_ID=
GUS_APP_SECRET=

# Signs the management console's session cookie. Use a long random string.
SESSION_SECRET=
